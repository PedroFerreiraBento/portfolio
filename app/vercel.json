{
  "framework": null,
  "outputDirectory": ".",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {"source": "/catalogo-online", "destination": "/catalogo-online.html"}
  ],
  "headers": [
    {
      "source": "/crm(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/crm-notifications.js": {
      "maxDuration": 90
    }
  },
  "crons": [
    {
      "path": "/api/crm-notifications",
      "schedule": "*/5 * * * *"
    }
  ]
}
